# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Beautiful, accessible components for Bonsai_web, on OxCaml"
description:
  "loon is a component library for Bonsai_web in the spirit of shadcn/ui: a small set of well-made components with a theme of CSS variables, usable as a library or copied into your project with the `loon add` command."
license: "MIT"
homepage: "https://github.com/lloyd-g-w/loon"
bug-reports: "https://github.com/lloyd-g-w/loon/issues"
depends: [
  "ocaml"
  "dune" {>= "3.17"}
  "core"
  "core_unix"
  "ppx_jane"
  "bonsai"
  "bonsai_web"
  "bonsai_web_test"
  "bonsai_test"
  "virtual_dom"
  "js_of_ocaml"
  "js_of_ocaml-ppx"
  "expect_test_helpers_core"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lloyd-g-w/loon.git"
