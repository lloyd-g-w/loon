(rule
 (target main.bc.js)
 (action
  (copy ../main.bc.js main.bc.js)))

; The docs' stylesheet: loon's Tailwind input and the site's own styles
; (../site.css: ui.shadcn.com's globals and typeset), scanning the docs'
; sources (examples use Tailwind classes too) as well as loon's.

(rule
 (target loon.css)
 (deps
  (glob_files ../../../src/css/*.css)
  (glob_files ../../../src/css/styles/*.css)
  (glob_files ../../../src/*.ml)
  (glob_files_rec ../../lib/**.ml)
  (glob_files ../../../blocks/*.ml)
  ../site.css
  ../../lib/typeset/typeset.css
  index.html)
 (action
  (system
   "{ cat ../../../src/css/*.css ../../../src/css/styles/*.css ../site.css; printf '\\n@source \"../../../src/*.ml\";\\n@source \"../../lib/**/*.ml\";\\n@source \"../../../blocks/*.ml\";\\n'; cat ../../lib/typeset/typeset.css; } > docs.input.css && tailwindcss --silent --input docs.input.css --output loon.css")))

(copy_files
 (files
  ../{index.html,icon.svg,temporal-polyfill.js,LICENSE-temporal-polyfill,geist-sans.woff2,geist-mono.woff2,geist-OFL.txt,placeholder.svg}))

(install
 (section share)
 (package loon)
 (files
  (main.bc.js as docs/main.bc.js)
  (loon.css as docs/loon.css)
  (index.html as docs/index.html)
  (icon.svg as docs/icon.svg)
  (temporal-polyfill.js as docs/temporal-polyfill.js)
  (LICENSE-temporal-polyfill as docs/LICENSE-temporal-polyfill)
  (geist-sans.woff2 as docs/geist-sans.woff2)
  (geist-mono.woff2 as docs/geist-mono.woff2)
  (geist-OFL.txt as docs/geist-OFL.txt)
  (placeholder.svg as docs/placeholder.svg)))
