(rule
 (target main.bc.js)
 (action
  (copy ../main.bc.js main.bc.js)))

; The docs' stylesheet: loon's Tailwind input, scanning the docs' sources
; (examples use Tailwind classes too) as well as loon's; then Typeset's
; typeset.css (docs/lib/typeset).

(rule
 (target loon.css)
 (deps
  (glob_files ../../../src/css/*.css)
  (glob_files ../../../src/*.ml)
  (glob_files_rec ../../lib/**.ml)
  ../../lib/typeset/typeset.css)
 (action
  (system
   "{ cat ../../../src/css/*.css; printf '\\n@source \"../../../src/*.ml\";\\n@source \"../../lib/**/*.ml\";\\n'; cat ../../lib/typeset/typeset.css; } > docs.input.css && tailwindcss --silent --input docs.input.css --output loon.css")))

(copy_files
 (files
  ../{index.html,docs.css,icon.svg,temporal-polyfill.js,LICENSE-temporal-polyfill,geist-sans.woff2,geist-mono.woff2,geist-OFL.txt}))

(install
 (section share)
 (package loon)
 (files
  (main.bc.js as docs/main.bc.js)
  (loon.css as docs/loon.css)
  (index.html as docs/index.html)
  (docs.css as docs/docs.css)
  (icon.svg as docs/icon.svg)
  (temporal-polyfill.js as docs/temporal-polyfill.js)
  (LICENSE-temporal-polyfill as docs/LICENSE-temporal-polyfill)
  (geist-sans.woff2 as docs/geist-sans.woff2)
  (geist-mono.woff2 as docs/geist-mono.woff2)
  (geist-OFL.txt as docs/geist-OFL.txt)))
