(rule
 (target main.bc.js)
 (action
  (copy ../main.bc.js main.bc.js)))

; The docs' stylesheet: loon's Tailwind input, scanning the docs' sources
; (examples use Tailwind classes too) as well as loon's.

(rule
 (target loon.css)
 (deps
  (glob_files ../../../src/css/*.css)
  (glob_files ../../../src/*.ml)
  (glob_files_rec ../../lib/**.ml))
 (action
  (system
   "{ cat ../../../src/css/*.css; printf '\\n@source \"../../../src/*.ml\";\\n@source \"../../lib/**/*.ml\";\\n'; } > docs.input.css && tailwindcss --input docs.input.css --output loon.css 2>tailwind.log || { cat tailwind.log >&2; exit 1; }")))

(copy_files
 (files
  ../{index.html,docs.css,icon.svg,temporal-polyfill.js,LICENSE-temporal-polyfill,recursive-sans.woff2,recursive-mono.woff2,recursive-OFL.txt}))

(install
 (section share)
 (package loon)
 (files
  (main.bc.js as docs/main.bc.js)
  (loon.css as docs/loon.css)
  (index.html as docs/index.html)
  (docs.css as docs/docs.css)
  (icon.svg as docs/icon.svg)
  (temporal-polyfill.js as docs/temporal-polyfill.js)
  (LICENSE-temporal-polyfill as docs/LICENSE-temporal-polyfill)
  (recursive-sans.woff2 as docs/recursive-sans.woff2)
  (recursive-mono.woff2 as docs/recursive-mono.woff2)
  (recursive-OFL.txt as docs/recursive-OFL.txt)))
