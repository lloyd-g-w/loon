; The registry: every component's files, embedded at build time from src/
; (cli/gen), and the blocks' from blocks/, and what `loon` does with them.

(library
 (name loon_registry)
 (inline_tests
  (flags
   (-source-tree-root .)))
 (preprocess
  (pps ppx_jane))
 (libraries
  core
  core_unix
  core_unix.sys_unix
  patience_diff
  expect_test_helpers_core
  loon_scan))

(rule
 (target data.ml)
 (deps
  ../../src/dune
  ../../src/embedded/dune
  (glob_files ../../src/*.ml)
  (glob_files ../../src/*.mli)
  (glob_files ../../src/css/*.css)
  (glob_files ../../blocks/*.ml)
  (glob_files ../../blocks/*.mli))
 (action
  (with-stdout-to
   data.ml
   (run ../gen/gen.exe %{deps}))))

(rule
 (target styles_data.ml)
 (deps
  (glob_files ../../src/css/styles/*.css))
 (action
  (with-stdout-to
   styles_data.ml
   (run ../gen/gen.exe -styles %{deps}))))

; loon's Cn (tailwind-merge), for merging a style's classes into a
; component's.

(rule
 (target cn.ml)
 (deps ../../src/cn.ml)
 (action
  (with-stdout-to
   cn.ml
   (progn
    (echo "(* Generated from loon's src/cn.ml. *)\n")
    (system
     "sed -e 's/^open! Import$/open! Core/' -e '/^let attr /d' -e '/^let with_class /d' ../../src/cn.ml")))))
