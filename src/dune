; loon: the components, ported from shadcn/ui. Each component is one module
; whose class strings are shadcn's Tailwind classes, so that `loon add` can
; copy it into a project unchanged. embedded/ holds the stylesheet as an
; OCaml string (a subdirectory, so the *.ml Tailwind scans leave it out).

(include_subdirs unqualified)

(library
 (name loon)
 (public_name loon)
 (preprocess
  (pps ppx_jane js_of_ocaml-ppx bonsai.ppx_bonsai))
 (libraries
  core
  bonsai
  bonsai_web
  virtual_dom
  virtual_dom.svg
  js_of_ocaml))

; The stylesheet's Tailwind input: css/*.css in name order (Tailwind and its
; plugins, the theme, then sonner.css: Sonner's own stylesheet), the styles
; (css/styles/*.css: shadcn's Vega, Nova, ...), and
; @source lines for the sources beside it: here, loon's; installed in
; lib/loon/, loon's and loon.blocks' (lib/loon/blocks/), so that a project's
; own Tailwind input can @import it (Tailwind resolves the @source paths
; from this file's real path). It depends on the sources so that, within a
; dune workspace, they are in _build beside it when it is imported.

(rule
 (target loon.input.css)
 (deps
  (glob_files css/*.css)
  (glob_files css/styles/*.css)
  (glob_files *.ml))
 (action
  (with-stdout-to
   loon.input.css
   (progn
    (system "cat css/*.css css/styles/*.css")
    (echo "\n@source \"./*.ml\";\n@source \"./blocks/*.ml\";\n")))))

(rule
 (target loon.css)
 (deps
  loon.input.css
  (glob_files *.ml))
 (action
  (system
   "tailwindcss --silent --input loon.input.css --output loon.css")))

(install
 (section share)
 (package loon)
 (files loon.css))

(install
 (section lib)
 (package loon)
 (files loon.input.css))
