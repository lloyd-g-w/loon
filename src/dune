; loon: the components, ported from shadcn/ui. Each component is one module
; whose class strings are shadcn's Tailwind classes, so that `loon add` can
; copy it into a project unchanged. embedded/ holds the stylesheet as an
; OCaml string (a subdirectory, so the *.ml Tailwind scans leave it out).

(include_subdirs unqualified)

(library
 (name loon)
 (public_name loon)
 (preprocess
  (pps ppx_jane js_of_ocaml-ppx bonsai.ppx_bonsai))
 (libraries
  core
  bonsai
  bonsai_web
  virtual_dom
  virtual_dom.svg
  js_of_ocaml))

; The stylesheet's Tailwind input: css/*.css in name order (Tailwind and its
; plugins, the theme, then the stylesheets of components not yet ported),
; written here, next to the sources it scans.

(rule
 (target loon.input.css)
 (deps
  (glob_files css/*.css))
 (action
  (with-stdout-to
   loon.input.css
   (progn
    (system "cat css/*.css")
    (echo "\n@source \"./*.ml\";\n")))))

(rule
 (target loon.css)
 (deps
  loon.input.css
  (glob_files *.ml))
 (action
  (system
   "tailwindcss --input loon.input.css --output loon.css 2>tailwind.log || { cat tailwind.log >&2; exit 1; }")))

(install
 (section share)
 (package loon)
 (files loon.css loon.input.css))
